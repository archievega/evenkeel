    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbound calls by outcome",
      "description": "`timeout` and `connection` are the provider. `bulkhead_full` and `budget_exhausted` are this service refusing to queue behind it. `malformed`, `oversized` and `redirected` mean the provider answered with something that was never a decision \u2014 and none of the three is read as approval.",
      "datasource": {
        "type": "prometheus",
        "uid": "evenkeel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "evenkeel-prometheus"
          },
          "expr": "sum by (outcome) (rate(evenkeel_external_call_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },

              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "WalletPageResponse",
        "type": "object"
      },
      "WalletResponse": {
        "properties": {
          "balance": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Balance",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "owner_id",
          "balance",
          "currency",
          "status",
          "version"
        ],
        "title": "WalletResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "Owner bearer token": {
        "bearerFormat": "UUID",
        "description": "Any UUID, and it is the owner id — there is no signup, no login endpoint and no token service in this template.\n\nThe bundled `DevIdentityProvider` treats the bearer token as the identity, so `Authorization: Bearer 018f4b2c-...` opens a fresh account and `uuidgen` is the whole onboarding flow. Wallets are scoped to it: use the same value again to see them, a different one to be somebody else.\n\nThat adapter refuses to start outside a local run, which is enforced by the boot guard. A real deployment swaps one provider method for a JWT/JWKS adapter, and this description changes with it.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nA wallet ledger, used here as the reference vertical for a backend template.\n\n**Getting a token.** There is none to get: send `Authorization: Bearer <any\nuuid>` and that UUID is your owner id. The bundled identity adapter is a\nplaceholder — no signup, no login endpoint — and it refuses to start outside a\nlocal run. Use the same UUID again to see your wallets, a different one to be\nsomebody else.\n\n**Reading the error contract.** Every failure is an\n[RFC 9457](https://www.rfc-editor.org/rfc/rfc9457) `application/problem+json`\ndocument. Branch on `code`, never on `title` — titles are prose and may be\nreworded, codes are part of the contract. Every response carries a\n`correlation_id`, in the body and in the `X-Correlation-ID` header; quote it\nwhen reporting a failure and it will find the server-side log line.\n\n**Retrying safely.** Send an `Idempotency-Key` header on deposits and\nwithdrawals. A retry then returns the original entry with `replayed: true`\ninstead of moving money again — including when the retry arrives while the\nfirst request is still in flight. Reusing one key with a different payload is\nrefused with `409`, never silently confirmed.\n\n**Ownership.** Every read is filtered by owner in SQL rather than checked\nafterwards, so a wallet belonging to someone else is reported as absent rather\nthan forbidden. The status code cannot be used to discover which ids exist.\n\n**Money.** Amounts are decimal strings, never JSON numbers, and arithmetic\nacross currencies is refused rather than converted.\n",
    "title": "evenkeel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness: is this process still able to serve?\n\nDeliberately checks nothing external. A liveness probe that fails when the\ndatabase is briefly unreachable makes the orchestrator kill every healthy\nreplica during a database blip, turning a partial outage into a total one.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: can this process serve *right now*?\n\nReturning a hardcoded \"ready\" is worse than having no probe at all: the\nload balancer keeps routing to a replica that cannot reach its database,\nand the deploy that broke the connection string still goes green.",
        "operationId": "readiness_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "A dependency is unreachable. The body names which one and the class of failure, never the connection string."
          }
        },
        "summary": "Readiness",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/wallets": {
      "get": {
        "description": "Cursor-paginated, newest first.\n\nPass `next_cursor` back as `cursor` to walk further. Offsets are not\nsupported on purpose: they make deep pages linearly slower and let\nconcurrent inserts shift rows between pages.",
        "operationId": "list_wallets_v1_wallets_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "No credential was supplied, or it was not a valid owner id."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "The request failed validation, or violated a domain rule that is not a conflict — mixing currencies, for example. `details.errors` names the offending fields but never echoes their values."
          }
        },
        "security": [
          {
            "Owner bearer token": []
          }
        ],
        "summary": "List the caller's wallets",
        "tags": [
          "wallets"
        ]
      },
      "post": {
        "description": "Handlers stay this thin.\n\nParse, call one use case, shape the response. No business rules, no\nrepository access, no transaction handling -- that is what keeps the same\nuse case reusable from a worker, a CLI or an MCP tool.",
        "operationId": "open_wallet_v1_wallets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenWalletRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "No credential was supplied, or it was not a valid owner id."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "The request failed validation, or violated a domain rule that is not a conflict — mixing currencies, for example. `details.errors` names the offending fields but never echoes their values."
          }
        },
        "security": [
          {
            "Owner bearer token": []
          }
        ],
        "summary": "Open a wallet",
        "tags": [
          "wallets"
        ]
      }
    },
    "/v1/wallets/{wallet_id}": {
      "get": {
        "description": "A wallet owned by someone else is reported as absent, not forbidden.",
        "operationId": "get_wallet_v1_wallets__wallet_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "wallet_id",
            "required": true,

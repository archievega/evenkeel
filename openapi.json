          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "MoneyRequest": {
        "examples": [
          {
            "amount": "100.00",
            "currency": "EUR",
            "description": "salary"
          }
        ],
        "properties": {
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,18}|(?=[\\d.]{1,21}0*$)\\d{0,18}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "description": "Positive, at most two decimal places. Sent as a JSON string so no float rounding happens in transit.",
            "examples": [
              "100.00"
            ],
            "title": "Amount"
          },
          "currency": {
            "description": "Must match the wallet's currency; a mismatch is refused, not converted.",
            "examples": [
              "EUR"
            ],
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "default": "",
            "description": "Free text recorded on the ledger entry. Part of the idempotency fingerprint: the same key with a different description is a different request.",
            "examples": [
              "salary"
            ],
            "maxLength": 200,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "MoneyRequest",
        "type": "object"
      },
      "MovementResponse": {
        "properties": {
          "balance": {
            "description": "Balance after the movement.",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Balance",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "entry_id": {
            "description": "The ledger entry this movement wrote.",
            "format": "uuid",
            "title": "Entry Id",
            "type": "string"
          },
          "replayed": {
            "description": "True when an idempotency key matched an earlier request. Nothing was applied a second time; the entry is the original one.",

        ],
        "title": "OpenWalletRequest",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 `application/problem+json`.",
        "examples": [
          {
            "code": "WALLET_INSUFFICIENT_FUNDS",
            "correlation_id": "489b1a95-1123-43ef-b6f6-03bbb5e15248",
            "details": {
              "balance": "70.00",
              "requested": "1000.00"
            },
            "instance": "/v1/wallets/01a0084a-d15c-7122-bc8c-a81b38e8a2f4/withdrawals",
            "status": 409,
            "title": "Wallet insufficient funds",
            "type": "about:blank#wallet_insufficient_funds"
          }
        ],
        "properties": {
          "code": {
            "description": "Machine-readable code. Branch on this, never on `title` — titles are prose and may be reworded; codes are part of the contract.",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Quote this when reporting the failure; it is the key to the server-side log line. Present on every response this API produces.",
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Structured context, shape depending on `code`. Never contains the rejected value or any server internals.",
            "title": "Details"
          },
          "instance": {
            "description": "Path of the request that produced the problem.",
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code, repeated for clients that lose it.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short human-readable summary. Safe to display.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "Stable URI reference identifying the problem kind.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",

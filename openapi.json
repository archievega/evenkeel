          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "built_at": {
            "title": "Built At",
            "type": "string"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "built_at"
        ],
        "title": "VersionResponse",
        "type": "object"
      },

# Copy to .env. Nested settings use a double underscore: APP__<SECTION>__<FIELD>.
# Every value here is a placeholder — the server refuses to start in production
# while the secret and the database password are still defaults.

# `local` relaxes the boot guard and opens /docs. Anything else — including
# leaving this unset — gets the strict posture.
APP__APP__ENVIRONMENT=local
APP__APP__PORT=8000
APP__APP__WORKERS=1
APP__APP__SECRET_KEY=change-me
# The only adapter that exists; the boot guard refuses it outside `local`.
APP__APP__IDENTITY_PROVIDER=dev
APP__APP__LOGGING__LEVEL=INFO
APP__APP__LOGGING__JSON_LOGS=false

APP__DATABASE__HOST=localhost
APP__DATABASE__PORT=5432
APP__DATABASE__USER=evenkeel
APP__DATABASE__PASSWORD=evenkeel
APP__DATABASE__DATABASE=evenkeel

# Empty keeps the in-memory lock, rate limiter and idempotency store.
# Set it to make those guarantees hold across replicas.
APP__REDIS__URL=

# Risk assessment on the money path. `allow-all` needs no third party and is
# the default; `http` turns on the real outbound adapter and requires a URL.
APP__RISK__PROVIDER=allow-all
APP__RISK__BASE_URL=
APP__RISK__PATH=/decisions
APP__RISK__API_KEY=
# When the provider cannot be reached: false refuses the movement with a 503,
# true lets it through unassessed. Closed by default — an unassessed movement is
# permanent, a 503 is not.
APP__RISK__FAIL_OPEN=false
APP__RISK__HTTP__TOTAL_TIMEOUT_MS=800
# Wall clock for the whole call including retries. The worst-case number.
APP__RISK__HTTP__BUDGET_MS=1500
APP__RISK__HTTP__MAX_ATTEMPTS=2
# Concurrent calls allowed in flight. Sized against the database pool.
APP__RISK__HTTP__BULKHEAD_LIMIT=32

# Movement policy, per owner.
APP__MOVEMENTS__RATE_LIMIT_ENABLED=true
APP__MOVEMENTS__RATE_LIMIT_LIMIT=30
APP__MOVEMENTS__RATE_LIMIT_WINDOW_SECONDS=60

# Serves /metrics in Prometheus format.
APP__OBSERVABILITY__METRICS_ENABLED=false
APP__OBSERVABILITY__TRACING_ENABLED=false
APP__OBSERVABILITY__OTLP_ENDPOINT=
